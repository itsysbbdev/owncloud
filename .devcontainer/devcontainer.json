{
  "name": "ownCloud-DaC-Env",
  "image": "ghcr.io/itsysbbdev/dac-architect-base:latest",
  "runArgs": [
    "--name", "devcontainer-owncloud-dac",
    "--hostname", "owncloud-dac"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.azure,target=/home/vscode/.azure,type=bind",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "ms-azuretools.vscode-bicep",
        "redhat.vscode-yaml"
      ]
    }
  },
  "remoteUser": "vscode"
}
